# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  StayVise — Environment Variables                                           ║
# ║  Copy this file to .env and fill in your real values.                       ║
# ║  NEVER commit the actual .env file — it contains secrets.                   ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── Application ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# ── Security ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_64_char_hex_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours

# ── Database ─────────────────────────────────────────────────────────────────────
# Local dev (Docker): postgresql+asyncpg://stayvise:stayvise_dev_password@localhost:5432/stayvise
# Production: use your managed PostgreSQL URL (e.g. Supabase, Neon, RDS)
DATABASE_URL=postgresql+asyncpg://stayvise:stayvise_dev_password@localhost:5432/stayvise
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ── Redis ────────────────────────────────────────────────────────────────────────
# Local dev (Docker): redis://localhost:6379/0
# Production: use your managed Redis URL (e.g. Upstash, Redis Cloud)
REDIS_URL=redis://localhost:6379/0
REDIS_RATE_LIMIT_DB=1

# ── Razorpay ─────────────────────────────────────────────────────────────────────
# Step 1 → https://dashboard.razorpay.com
# Step 2 → Settings → API Keys → Generate Key
# Step 3 → Copy Key ID and Key Secret below
# For escrow/route: Settings → Account → Account Number (or Virtual Account)
# IMPORTANT: Use "Test Mode" keys during development (prefix rzp_test_)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_ACCOUNT_NUMBER=your_razorpay_route_account_number

# Razorpay Webhook:
# Dashboard → Webhooks → + Add New Webhook
# Set URL to: https://your-domain.com/api/v1/webhooks/razorpay
# Choose events: payment.captured, refund.created, transfer.settled
# Copy the webhook secret below
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── WhatsApp Business Cloud API ───────────────────────────────────────────────────
# Step 1 → https://developers.facebook.com → Create App → Business type
# Step 2 → Add "WhatsApp" product → API Setup
# Step 3 → Copy Phone Number ID and generate System User Token
# Step 4 → Configure Webhook:
#           Callback URL: https://your-domain.com/api/v1/webhooks/whatsapp
#           Verify Token: the value you set for WHATSAPP_VERIFY_TOKEN
#           Subscribe to: messages

WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here
WHATSAPP_API_VERSION=v20.0

# ── Frontend / CORS ───────────────────────────────────────────────────────────────
# Vite dev server origin; in production set to your actual domain
FRONTEND_URL=http://localhost:5173
# Comma-separated extra allowed origins (optional)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Business Rules ────────────────────────────────────────────────────────────────
ESCROW_FEE_PERCENT=2.0          # Platform fee as % of milestone amount
AUTO_RELEASE_DAYS=5             # Auto-release funds after N days of client silence

# ── Celery (optional overrides — defaults to REDIS_URL) ───────────────────────────
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
